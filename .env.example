# Copie para .env e ajuste. Nunca commite o .env.
# Lido por scripts/deploy-local.sh para criar o Secret "orcamento-secrets" no cluster local.

# Senha do sa do pod SQL Server (mínimo 8 caracteres, maiúscula, minúscula, número e símbolo).
SA_PASSWORD=SuaSenhaForte@123

# Mesma chave da API do monólito e da Lambda de autenticação: o microsserviço só valida
# tokens emitidos por eles. Mínimo 32 caracteres.
JWT_SECRET_KEY=sua-chave-jwt-secreta-com-no-minimo-32-caracteres

# RabbitMQ do overlay local (pod orcamento-rabbitmq), usado pela Saga da OS.
RABBITMQ_USER=orcamento
RABBITMQ_PASSWORD=TroqueEstaSenhaDoRabbit

# Opcionais — vazios mantêm o gateway de pagamento fake.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=
